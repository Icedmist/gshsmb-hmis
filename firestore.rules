rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasUserProfile() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function getUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return hasUserProfile() && getUserProfile().get('role', '') == 'super_admin';
    }
    
    function isHospitalAdmin() {
      return hasUserProfile() && getUserProfile().get('role', '') == 'hospital_admin';
    }
    
    function isHROfficer() {
      return hasUserProfile() && getUserProfile().get('role', '') == 'hr_officer';
    }
    
    function isExecutiveSecretary() {
      return hasUserProfile() && getUserProfile().get('role', '') == 'executive_secretary';
    }
    
    function isHospitalScopedRole() {
      return isHospitalAdmin() || isPharmacyAdmin() || isLabAdmin() || isNursingAdmin() || isMedicalAdmin() || isPRSAdmin();
    }
    
    function isOwnHospitalData() {
      return !isHospitalScopedRole() ||
             !('hospital_id' in request.resource.data) ||
             request.resource.data.hospital_id == null ||
             request.resource.data.hospital_id == getUserProfile().get('hospital_id', null);
    }
    
    function isDirectorNursing() {
      return hasUserProfile() && getUserProfile().get('role', '') == 'director_nursing_services';
    }
    
    function isDirectorMedical() {
      return hasUserProfile() && getUserProfile().get('role', '') == 'director_medical_services';
    }
    
    function isDirectorPharmaceutical() {
      return hasUserProfile() && getUserProfile().get('role', '') == 'director_pharmaceutical_services';
    }
    
    function isDirectorLaboratory() {
      return hasUserProfile() && getUserProfile().get('role', '') == 'director_laboratory_services';
    }
    
    function isDirectorPRS() {
      return hasUserProfile() && getUserProfile().get('role', '') == 'director_prs';
    }
    
    function isDirectorFinance() {
      return hasUserProfile() && getUserProfile().get('role', '') == 'director_finance';
    }

    function isPharmacyAdmin() {
      return hasUserProfile() && getUserProfile().get('role', '') == 'pharmacy_admin';
    }

    function isLabAdmin() {
      return hasUserProfile() && getUserProfile().get('role', '') == 'lab_admin';
    }

    function isNursingAdmin() {
      return hasUserProfile() && getUserProfile().get('role', '') == 'nursing_admin';
    }

    function isMedicalAdmin() {
      return hasUserProfile() && getUserProfile().get('role', '') == 'medical_admin';
    }

    function isPRSAdmin() {
      return hasUserProfile() && getUserProfile().get('role', '') == 'prs_admin';
    }

    function isDirectorHR() {
      return hasUserProfile() && getUserProfile().get('role', '') == 'director_hr';
    }

    function isDirector() {
      return isDirectorNursing() || isDirectorMedical() || isDirectorPharmaceutical() || isDirectorLaboratory() || isDirectorPRS() || isDirectorFinance() || isDirectorHR();
    }

    function canManageContent() {
      return isAdmin() || isExecutiveSecretary() || isHospitalAdmin() || isHROfficer() || isDirector() || isPharmacyAdmin() || isLabAdmin() || isNursingAdmin() || isMedicalAdmin() || isPRSAdmin();
    }
    
    function isOwnUser(resourceId) {
      return isAuthenticated() && request.auth.uid == resourceId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isExecutiveSecretary();
      allow update: if isAdmin() || isExecutiveSecretary() || isOwnUser(userId);
      allow delete: if (isAdmin() || isExecutiveSecretary()) && !isOwnUser(userId);
    }

    // Hospitals collection
    match /hospitals/{hospitalId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isExecutiveSecretary();
    }

    // Departments collection
    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isExecutiveSecretary() || isHospitalAdmin();
    }

    // Employees collection
    match /employees/{empId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isExecutiveSecretary() || isHospitalAdmin() || isHROfficer() || isDirectorHR();
      allow delete: if isAdmin() || isExecutiveSecretary();
    }

    // Employee Transfers collection
    match /employeeTransfers/{transferId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isExecutiveSecretary() || isHROfficer() || isDirectorHR();
      allow delete: if isAdmin() || isExecutiveSecretary();
    }

    // Audit Logs collection
    match /auditLogs/{logId} {
      allow read: if isAdmin() || isExecutiveSecretary();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // System Settings collection
    match /systemSettings/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isExecutiveSecretary();
    }

    // Announcements collection
    match /announcements/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isExecutiveSecretary();
    }

    // Password Reset Tokens (legacy, not used with Firebase Auth)
    match /passwordResetTokens/{tokenId} {
      allow read, write: if false;
    }

    // Health check
    match /_health/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Nursing collections
    match /nursingWorkforce/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isExecutiveSecretary() || isDirectorNursing() || isNursingAdmin();
      allow delete: if isAdmin() || isExecutiveSecretary();
    }

    match /nursingAudits/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isExecutiveSecretary() || isDirectorNursing() || isNursingAdmin();
      allow delete: if isAdmin() || isExecutiveSecretary();
    }

    match /nursingSupervisionReports/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isExecutiveSecretary() || isDirectorNursing() || isNursingAdmin();
      allow delete: if isAdmin() || isExecutiveSecretary();
    }

    match /trainingPrograms/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isExecutiveSecretary() || isDirectorNursing() || isNursingAdmin() || isHROfficer() || isDirectorHR();
      allow delete: if isAdmin() || isExecutiveSecretary();
    }

    match /trainingAttendance/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isExecutiveSecretary() || isDirectorNursing() || isNursingAdmin() || isHROfficer() || isDirectorHR();
      allow delete: if isAdmin() || isExecutiveSecretary();
    }

    match /certifications/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isExecutiveSecretary() || isDirectorNursing() || isNursingAdmin();
      allow delete: if isAdmin() || isExecutiveSecretary();
    }

    // Catch-all for all other specialty collections
    // (medical, pharmaceutical, laboratory, PRS, financial, and any future collections)
    match /{collection}/{docId} {
      allow read: if isAuthenticated();
      allow create: if canManageContent() && isOwnHospitalData();
      allow update: if canManageContent() && isOwnHospitalData();
      allow delete: if isAdmin() || isExecutiveSecretary();
    }

    // --- Collaboration collections ---

    // Notifications: users read/write their own, admins can manage
    match /notifications/{docId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.user_id || isAdmin() || isExecutiveSecretary());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.user_id || isAdmin() || isExecutiveSecretary());
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.user_id || isAdmin() || isExecutiveSecretary());
    }

    // Message threads: participants & admins can read/write
    match /message_threads/{docId} {
      allow read: if isAuthenticated() && (resource.data.participants.hasAny([request.auth.uid]) || isAdmin() || isExecutiveSecretary());
      allow create: if isAuthenticated() && (request.resource.data.participants.hasAny([request.auth.uid]) || isAdmin() || isExecutiveSecretary());
      allow update: if isAuthenticated() && (resource.data.participants.hasAny([request.auth.uid]) || isAdmin() || isExecutiveSecretary());
      allow delete: if isAdmin() || isExecutiveSecretary();
    }

    // Messages: authenticated users can read/write
    match /messages/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || isExecutiveSecretary();
    }

    // Tasks: all authenticated can read, admin/ES can create/update/delete
    match /tasks/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isExecutiveSecretary();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || isExecutiveSecretary();
    }

    // Task comments: all authenticated can read/write
    match /task_comments/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || isExecutiveSecretary();
    }

    // Notification settings
    match /notification_settings/{docId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.user_id;
      allow write: if isAuthenticated() && request.auth.uid == resource.data.user_id;
    }

    // Workflows & history
    match /workflows/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || isExecutiveSecretary();
    }

    match /workflowSteps/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || isExecutiveSecretary();
    }

    match /workflowHistory/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || isExecutiveSecretary();
    }

    // ─── Locum / Staffing collections ───

    // Locum requests (employee-initiated)
    match /locum_requests/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || isExecutiveSecretary();
    }

    // Locum approvals (tracking approval steps)
    match /locum_approvals/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || isExecutiveSecretary();
    }

    // Locum assignments (created after full approval)
    match /locum_assignments/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || isExecutiveSecretary();
    }

    // Locum history (completed locums)
    match /locum_history/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || isExecutiveSecretary();
    }

    // Staffing requests (hospital-initiated requests for staff)
    match /staffing_requests/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || isExecutiveSecretary();
    }

    // Staff nominations (nominating staff for open staffing requests)
    match /staff_nominations/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || isExecutiveSecretary();
    }
  }
}

