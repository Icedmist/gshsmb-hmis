rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function getUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserProfile().role == 'super_admin';
    }
    
    function isHospitalAdmin() {
      return isAuthenticated() && getUserProfile().role == 'hospital_admin';
    }
    
    function isHROfficer() {
      return isAuthenticated() && getUserProfile().role == 'hr_officer';
    }
    
    function isExecutiveSecretary() {
      return isAuthenticated() && getUserProfile().role == 'executive_secretary';
    }
    
    function canManage() {
      return isAdmin() || isHospitalAdmin();
    }
    
    function isHospitalScopedRole() {
      return isHospitalAdmin() || isPharmacyAdmin() || isLabAdmin() || isNursingAdmin() || isMedicalAdmin() || isPRSAdmin();
    }

    function isBoardLevelRole() {
      return isAdmin() || isExecutiveSecretary() || isDirector() || isHROfficer();
    }

    function isOwnHospital(resourceHospitalId) {
      return !isHospitalScopedRole() || getUserProfile().hospital_id == resourceHospitalId;
    }
    
    function isOwnHospitalData() {
      return !isHospitalScopedRole() || request.resource.data.hospital_id == getUserProfile().hospital_id;
    }
    
    function isDirectorNursing() {
      return isAuthenticated() && getUserProfile().role == 'director_nursing_services';
    }
    
    function isDirectorMedical() {
      return isAuthenticated() && getUserProfile().role == 'director_medical_services';
    }
    
    function isDirectorPharmaceutical() {
      return isAuthenticated() && getUserProfile().role == 'director_pharmaceutical_services';
    }
    
    function isDirectorLaboratory() {
      return isAuthenticated() && getUserProfile().role == 'director_laboratory_services';
    }
    
    function isDirectorPRS() {
      return isAuthenticated() && getUserProfile().role == 'director_prs';
    }
    
    function isDirectorFinance() {
      return isAuthenticated() && getUserProfile().role == 'director_finance';
    }

    function isPharmacyAdmin() {
      return isAuthenticated() && getUserProfile().role == 'pharmacy_admin';
    }

    function isLabAdmin() {
      return isAuthenticated() && getUserProfile().role == 'lab_admin';
    }

    function isNursingAdmin() {
      return isAuthenticated() && getUserProfile().role == 'nursing_admin';
    }

    function isMedicalAdmin() {
      return isAuthenticated() && getUserProfile().role == 'medical_admin';
    }

    function isPRSAdmin() {
      return isAuthenticated() && getUserProfile().role == 'prs_admin';
    }

    function isDirectorHR() {
      return isAuthenticated() && getUserProfile().role == 'director_hr';
    }

    function isDirector() {
      return isDirectorNursing() || isDirectorMedical() || isDirectorPharmaceutical() || isDirectorLaboratory() || isDirectorPRS() || isDirectorFinance() || isDirectorHR();
    }

    function canManageContent() {
      return isAdmin() || isExecutiveSecretary() || isHospitalAdmin() || isHROfficer() || isDirector() || isPharmacyAdmin() || isLabAdmin() || isNursingAdmin() || isMedicalAdmin() || isPRSAdmin();
    }
    
    function isOwnUser(resourceId) {
      return isAuthenticated() && request.auth.uid == resourceId;
    }

    // Users collection
    match /users/{userId} {
      // Anyone authenticated can read users (for name lookups, etc.)
      allow read: if isAuthenticated();
      
      // Only admins can create/update/delete users
      // Note: User creation via Cloud Functions bypasses security rules
      allow create: if isAdmin();
      allow update: if isAdmin() || isOwnUser(userId);
      allow delete: if isAdmin() && !isOwnUser(userId);
    }

    // Hospitals collection
    match /hospitals/{hospitalId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Departments collection
    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isHospitalAdmin();
      allow update: if isAdmin() || isHospitalAdmin();
      allow delete: if isAdmin() || isHospitalAdmin();
    }

    // Employees collection
    match /employees/{empId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isHospitalAdmin() || isHROfficer();
      allow update: if isAdmin() || isHospitalAdmin() || isHROfficer();
      allow delete: if isAdmin();
    }

    // Employee Transfers collection
    match /employeeTransfers/{transferId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isHROfficer();
      allow update: if isAdmin() || isHROfficer();
      allow delete: if isAdmin();
    }

    // Audit Logs collection
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }

    // Password Reset Tokens (legacy, not used with Firebase Auth)
    match /passwordResetTokens/{tokenId} {
      allow read, write: if false;
    }

    // Health check
    match /_health/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Nursing collections
    match /nursingWorkforce/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isDirectorNursing();
      allow update: if isAdmin() || isDirectorNursing();
      allow delete: if isAdmin();
    }

    match /nursingAudits/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isDirectorNursing();
      allow update: if isAdmin() || isDirectorNursing();
      allow delete: if isAdmin();
    }

    match /nursingSupervisionReports/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isDirectorNursing();
      allow update: if isAdmin() || isDirectorNursing();
      allow delete: if isAdmin();
    }

    match /trainingPrograms/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isDirectorNursing() || isHROfficer();
      allow update: if isAdmin() || isDirectorNursing() || isHROfficer();
      allow delete: if isAdmin();
    }

    match /trainingAttendance/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isDirectorNursing() || isHROfficer();
      allow update: if isAdmin() || isDirectorNursing() || isHROfficer();
      allow delete: if isAdmin();
    }

    match /certifications/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isDirectorNursing();
      allow update: if isAdmin() || isDirectorNursing();
      allow delete: if isAdmin();
    }

    // Catch-all for all other specialty collections
    // (medical, pharmaceutical, laboratory, PRS, and any future collections)
    match /{collection}/{docId} {
      allow read: if isAuthenticated();
      allow create: if canManageContent() && isOwnHospitalData();
      allow update: if canManageContent() && isOwnHospitalData();
      allow delete: if isAdmin();
    }

    // --- Collaboration collections ---

    // Notifications: users read/write their own
    match /notifications/{docId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.user_id;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && request.auth.uid == resource.data.user_id;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.user_id;
    }

    // Message threads: participants can read/write
    match /message_threads/{docId} {
      allow read: if isAuthenticated() && resource.data.participants.hasAny([request.auth.uid]);
      allow create: if isAuthenticated() && request.resource.data.participants.hasAny([request.auth.uid]);
      allow update: if isAuthenticated() && resource.data.participants.hasAny([request.auth.uid]);
      allow delete: if isAdmin();
    }

    // Messages: participants of the parent thread can read/write
    match /messages/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Tasks: all authenticated can read, admin/ES can create/update/delete
    match /tasks/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isExecutiveSecretary();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || isExecutiveSecretary();
    }

    // Task comments: all authenticated can read/write
    match /task_comments/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Notification settings
    match /notification_settings/{docId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.user_id;
      allow write: if isAuthenticated() && request.auth.uid == resource.data.user_id;
    }

    // ─── Locum / Staffing collections ───

    // Locum requests (employee-initiated)
    match /locum_requests/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Locum approvals (tracking approval steps)
    match /locum_approvals/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Locum assignments (created after full approval)
    match /locum_assignments/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Locum history (completed locums)
    match /locum_history/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Staffing requests (hospital-initiated requests for staff)
    match /staffing_requests/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Staff nominations (nominating staff for open staffing requests)
    match /staff_nominations/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }
  }
}
